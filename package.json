{
  "name": "immoya",
  "version": "0.1.0",
  "description": "IMMOYA — plateforme immobiliere premium (portfolio)",
  "private": true,
  "main": "backend/server.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./src/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./src/css/styles.css --watch",
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "build": "npm run build:css && node scripts/build-static.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13"
  },
  "engines": {
    "node": ">=18"
  }
}
