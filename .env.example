# Copie ce fichier en ".env" et renseigne tes vraies valeurs (ne jamais commiter ".env")
UNTERA_API_KEY=
UNTERA_BASE_URL=https://api.untera.io/api/v1
PORT=4000

# Hash bcrypt du mot de passe admin (jamais le mot de passe en clair). Génère-le avec :
#   node -e "console.log(require('bcryptjs').hashSync('ton-mot-de-passe', 10))"
ADMIN_PASSWORD_HASH=
